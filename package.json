{
	"name": "minifolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#client/*": "./src/*",
		"#server/*": "./server/*"
	},
	"scripts": {
		"dev": "node --watch --watch-path=server --watch-path=vite.config.ts --watch-path=index.html --watch-preserve-output --watch-kill-signal=SIGINT server/index.ts --dev",
		"build": "vite build --app",
		"git:build": "node scripts/build-git.ts",
		"og:image": "node scripts/og-image.ts",
		"og:image:all": "pnpm og:image && pnpm og:image --handle=\"sheraff.dev\" --output=\"og-bsky.png\" && pnpm og:image --handle=\"chaponflo\" --output=\"og-twitter.png\"",
		"resume:md": "node scripts/resume-markdown.ts --input public/resume.html --output public/resume.md",
		"resume:pdf": "google-chrome --headless=new --disable-gpu --no-sandbox --print-to-pdf=\"$PWD/public/resume.pdf\" \"file://$PWD/public/resume.html\"",
		"start": "node dist/server/server.js",
		"check": "tsc -b --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@hono/standard-validator": "0.4.0",
		"drizzle-orm": "1.0.0-rc.4",
		"fast-xml-parser": "5.11.1",
		"hono": "4.13.8",
		"just-bash": "3.4.2",
		"solid-js": "1.9.15",
		"ssh2": "1.17.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@types/node": "26.6.1",
		"@types/ssh2": "1.15.6",
		"drizzle-kit": "1.0.0-rc.4",
		"parse5": "8.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vite-plugin-solid": "2.11.14",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@11.7.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.3.1",
			"onFail": "download"
		}
	}
}
