{
  "name": "minifolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=vite.config.ts --watch-path=index.html --watch-preserve-output server/index.ts --dev",
    "build": "vite build --app",
    "start": "node dist/server/server.js",
    "check": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "fast-xml-parser": "5.8.0",
    "hono": "4.12.23",
    "just-bash": "2.14.5",
    "solid-js": "1.9.13",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.8"
  }
}