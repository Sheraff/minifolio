{
	"name": "minifolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#client/*": "./src/*",
		"#server/*": "./server/*"
	},
	"scripts": {
		"dev": "node --watch --watch-path=server --watch-path=vite.config.ts --watch-path=index.html --watch-preserve-output server/index.ts --dev",
		"build": "vite build --app",
		"og:image": "node scripts/og-image.ts",
		"og:image:all": "pnpm og:image && pnpm og:image --handle=\"sheraff.dev\" --output=\"og-bsky.png\" && pnpm og:image --handle=\"chaponflo\" --output=\"og-twitter.png\"",
		"resume:md": "node scripts/resume-markdown.ts --input public/resume.html --output public/resume.md",
		"resume:pdf": "google-chrome --headless=new --disable-gpu --no-sandbox --print-to-pdf=\"$PWD/public/resume.pdf\" \"file://$PWD/public/resume.html\"",
		"start": "node dist/server/server.js",
		"check": "tsc -b --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "2.0.5",
		"fast-xml-parser": "5.9.0",
		"hono": "4.12.25",
		"just-bash": "3.0.1",
		"solid-js": "1.9.13",
		"ssh2": "^1.17.0",
		"valibot": "1.4.1"
	},
	"devDependencies": {
		"@types/node": "25.9.3",
		"@types/ssh2": "^1.15.5",
		"parse5": "8.0.1",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"vite-plugin-solid": "2.11.12",
		"vitest": "4.1.9"
	},
	"packageManager": "pnpm@11.7.0"
}
